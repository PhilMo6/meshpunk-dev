# Meshpunk P4 — hardware-true settings for the LilyGo T-Display P4.
# Seeded from Xinyuan-LilyGO/T-Display-P4 sdkconfig.defaults (the board
# vendor's values for this exact module); their app-specific entries
# (speech recognition, LVGL Kconfig, Ethernet PHY) are deliberately absent.

CONFIG_IDF_TARGET="esp32p4"

# THIS UNIT IS PRE-v3.0 SILICON (ROM banner "esp32p4-eco2"). IDF's default
# code generation targets chip revision v3.0; per Espressif's chip-revision
# documentation, a build for a pre-3.0 chip WITHOUT this option "will build
# an incompatible binary" — observed here as an illegal-instruction panic at
# the bootloader entry. Keep this line as long as any target unit is
# pre-3.0; it remains compatible with v3.x chips.
CONFIG_ESP32P4_SELECTS_REV_LESS_V3=y

CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions_meshpunk_p4.csv"

# 32MB PSRAM, hex (16-line) bus at 200MHz — the vendor configuration.
# 200MHz PSRAM sits behind the experimental-features gate in this IDF.
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_HEX=y
CONFIG_SPIRAM_SPEED_200M=y
CONFIG_IDF_EXPERIMENTAL_FEATURES=y

# Execute-in-place from PSRAM. On pre-rev3.0 silicon (this unit: ROM banner
# "esp32p4-eco2") IDF-5.5-era images WITHOUT this flag die at the bootloader
# entry with an illegal-instruction panic — esphome/esphome#15336 confirms
# this line as the fix for that exact crash, and wadamesh's working
# T-Display P4 build sets it too. It also stops whole-screen flicker during
# flash writes once the display is up (cache is not disabled for code).
CONFIG_SPIRAM_XIP_FROM_PSRAM=y

# DSI ISR stays serviceable during flash-cache-disabled windows (the
# wadamesh T-Display P4 build ships this; keeps the DPI stream from
# underflowing during flash writes).
CONFIG_LCD_DSI_ISR_IRAM_SAFE=y

CONFIG_CACHE_L2_CACHE_256KB=y
CONFIG_CACHE_L2_CACHE_LINE_128B=y

CONFIG_FREERTOS_HZ=1000

# Console: DEFAULT (UART0 primary + USB-Serial-JTAG as the non-blocking
# secondary) — the configuration both working builds for this board
# (LilyGo factory, wadamesh) ship. The port the PC sees is UART0: the
# board's USB-C data port is a CH343 USB-UART bridge (VID 1A86 / PID 55D3),
# and no USB-Serial-JTAG device has ever enumerated from it. Forcing
# USB-Serial-JTAG as the PRIMARY console was tried and the boot went silent
# before the bootloader's first log line on this v1.0 chip; do not
# reintroduce it without a hw round.

# esp-hosted: the boot-time constructor that would call esp_hosted_init()
# before app_main is left out (MESHPUNK option, libraries/esp_hosted/
# Kconfig). Arduino's cores/esp32/esp32-hal-hosted.c runs
# esp_hosted_sdio_set_config -> esp_hosted_init -> esp_hosted_connect_to_slave
# at the first WiFi or BLE use, the sequence rung 8 proved; the board layer
# registers the C6 reset callback (the C6 EN line is expander IO14) before
# that (plan Phase 2).
CONFIG_ESP_HOSTED_AUTO_INIT=n
# esp-hosted's console commands are not used.
CONFIG_ESP_HOSTED_CLI_ENABLED=n
# The SDIO transport's packet pool — 31 blocks of 1536 bytes, one contiguous
# 64-byte-aligned DMA allocation made at the first use of the C6 (the WiFi
# start; with WiFi off, the BLE start late in setup) — lives in PSRAM: the
# P4's SDMMC can DMA to and from PSRAM (SOC_SDMMC_PSRAM_DMA_CAPABLE), and a
# 46 KB contiguous internal block is not there any more once the Lua/LVGL
# bring-up has run. 2026-11-11: with WiFi off, BLE on and Ethernet on, the
# pool allocation at the BLE start failed and esp-hosted's assert rebooted
# the board on every boot.
CONFIG_ESP_HOSTED_MEMPOOL_PREFER_SPIRAM=y

# ── Firmware build (Phase 0 of docs/P4_PORT_PLAN_2026-10-12.md) ────────────

# Arduino 3.3.12 as a component: its main.cpp is app_main() and runs
# setup()/loop(). loop() on core 0 and a 16 KB loop stack match the S3 envs'
# -DARDUINO_RUNNING_CORE=0 / -DARDUINO_LOOP_STACK_SIZE=16384
# (meshpunk_tasks.cpp pins the mesh task to core 1).
CONFIG_AUTOSTART_ARDUINO=y
CONFIG_ARDUINO_RUN_CORE0=y
CONFIG_ARDUINO_LOOP_STACK_SIZE=16384

# Arduino's NetworkClientSecure (the TLS behind HTTPClient's https:// and
# WiFiClientSecure) compiles its whole ssl_client.cpp only when mbedTLS has
# a PSK key exchange enabled (MBEDTLS_KEY_EXCHANGE_SOME_PSK_ENABLED);
# without these two the library is an empty object and the link fails on
# start_ssl_client/ssl_init/... The #warning in ssl_client.cpp names them.
CONFIG_MBEDTLS_PSK_MODES=y
CONFIG_MBEDTLS_KEY_EXCHANGE_PSK=y

# -Os, what the Arduino S3 builds use; the rung builds were -Og.
CONFIG_COMPILER_OPTIMIZATION_SIZE=y

# sound.cpp and lib/ESP32-audioI2S drive the legacy I2S driver
# (driver/i2s.h), which IDF 5 marks deprecated with a #warning per file.
CONFIG_I2S_SUPPRESS_DEPRECATE_WARN=y

# Task watchdog: a starved idle task panics (reboot with a register dump) —
# the S3 builds' value; elf_host.cpp re-arms "5 s, panic" after every module
# run on both builds. loop() sleeps one tick per pass (main.cpp), so IDLE0
# runs every millisecond. IDLE1 is checked too (IDF default; the S3 does
# not check it): a mesh task that stops sleeping panics instead of freezing
# the UI silently.
CONFIG_ESP_TASK_WDT_PANIC=y

# FAT long file names on the SD card. IDF's default is 8.3 names only
# (FATFS_LFN_NONE): the card mounted and `mkdir /meshpunk` worked, but
# fopen("/sd/meshpunk/wifi_creds") failed — every firmware path longer than
# 8.3 (firmware_prefs, wifi_creds, lora_protos, apps/<name>/main.lua, ...)
# needs long names. The values are the Arduino 2.0.17 S3 SDK's (its
# tools/sdk/esp32s3/sdkconfig): the long-name buffer on the caller's stack
# (512 bytes per FatFs call), 255-character names, UTF-8 on the API side,
# OEM codepage 850 so short names on a card match those the S3 boards
# write, and FatFs buffers (a 4 KB per-file cache with 4096-byte sectors)
# in PSRAM rather than the internal heap.
CONFIG_FATFS_LFN_STACK=y
CONFIG_FATFS_MAX_LFN=255
CONFIG_FATFS_API_ENCODING_UTF_8=y
CONFIG_FATFS_CODEPAGE_850=y
CONFIG_FATFS_ALLOC_PREFER_EXTRAM=y

# ELF modules execute from PSRAM. With this option on (IDF's default with
# SPIRAM_BOOT_INIT), esp_cpu_configure_region_protection() splits the PSRAM
# address range into locked PMP regions — the XIP text copy R+X, the heap
# R+W only — and the first instruction fetched from a loaded module faults
# ("Instruction access fault", MCAUSE 1, MTVAL = the module address; build
# 20). With it off the PSRAM range is one locked R+W+X entry
# (esp_hw_support/port/esp32p4/cpu_region_protect.c, the branch without
# SPIRAM_PRE_CONFIGURE_MEMORY_PROTECTION), as the S3 boards have no
# execute restriction on PSRAM either.
CONFIG_SPIRAM_PRE_CONFIGURE_MEMORY_PROTECTION=n

# ── Bluetooth: NimBLE host on the P4, controller on the C6 ─────────────────

# The C6 runs LilyGo's esp-hosted 2.12.3 image, which offers its BLE
# controller over the SDIO link (HCI over SDIO). The host side is IDF's
# NimBLE with esp-hosted's VHCI driver as the host-controller transport
# (libraries/esp_hosted/host/drivers/bt/vhci_drv.c), so IDF's UART
# transport, the default once the controller is disabled, is off. The
# Arduino BLE library builds on the P4 only with ESP_HOSTED_ENABLE_BT_NIMBLE
# (libraries/BLE/src/BLEDevice.h); the firmware's class for this backend is
# src/radio/punk_serial_ble.cpp. Peripheral + broadcaster only (the
# companion is an advertising GATT server), one connection, bonded
# secure-connections or legacy pairing with the bonds kept in NVS, host
# memory in PSRAM.
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_CONTROLLER_DISABLED=y
CONFIG_BT_NIMBLE_TRANSPORT_UART=n
CONFIG_ESP_HOSTED_ENABLE_BT_NIMBLE=y
CONFIG_ESP_HOSTED_NIMBLE_HCI_VHCI=y
CONFIG_BT_NIMBLE_ROLE_CENTRAL=n
CONFIG_BT_NIMBLE_ROLE_OBSERVER=n
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=1
CONFIG_BT_NIMBLE_SECURITY_ENABLE=y
CONFIG_BT_NIMBLE_SM_LEGACY=y
CONFIG_BT_NIMBLE_SM_SC=y
CONFIG_BT_NIMBLE_NVS_PERSIST=y
CONFIG_BT_NIMBLE_MAX_BONDS=3
CONFIG_BT_NIMBLE_MEM_ALLOC_MODE_EXTERNAL=y
CONFIG_BT_NIMBLE_50_FEATURE_SUPPORT=n
CONFIG_BT_NIMBLE_LOG_LEVEL_WARNING=y

# ── USB: the OTG high-speed port (USB-C USB1 and the USB-A host socket) ────

# Host mode (src/usb/usb_core.cpp) uses IDF's host library on its default
# peripheral, the high-speed one; hubs on, the firmware serving one accessory
# behind a hub. Drive mode (src/usb/usb_msc_dev.cpp) uses esp_tinyusb's MSC
# class on the same port with the component's P4 FIFO default; the strings
# are what the PC shows for the drive.
CONFIG_USB_HOST_HUBS_SUPPORTED=y
CONFIG_TINYUSB_MSC_ENABLED=y
CONFIG_TINYUSB_DESC_MANUFACTURER_STRING="MeshPunk"
CONFIG_TINYUSB_DESC_PRODUCT_STRING="T-Display P4 SD"
CONFIG_TINYUSB_DESC_MSC_STRING="T-Display P4 SD"
